{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .icon-and-text-wrapper {
    border: 1px solid rgba(243, 222, 190, 0.4);
    padding: 20px 10px;
    border-radius: 4px;
    margin-bottom: 2rem;
  }

  .icon-and-text-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding: 0 20px;
  }

  .icon-and-text-header h2 {
    margin: 0;
    font-size: calc(var(--font-heading-scale) * 2rem);
  }
  
  .icon-and-text-header-icon {
    color: #f2e4ad;
  }

  .icon-and-text-header-icon svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  .icon-and-text-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .icon-and-text-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .icon-and-text-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 25px 20px;
    border-bottom: 1px solid rgba(243, 222, 190, 0.2);
    position: relative;
  }

  @media screen and (max-width: 749px) {
    .icon-and-text-item:last-child {
      border-bottom: none;
    }
  }
  
  @media screen and (min-width: 750px) {
    .icon-and-text-item {
      border-right: 1px solid rgba(243, 222, 190, 0.2);
    }
    .icon-and-text-item:nth-child(3n) {
      border-right: none;
    }
    .icon-and-text-item:nth-last-child(-n+3) {
      border-bottom: none;
    }
  }

  .icon-and-text-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: #f2e4ad;
  }

  .icon-and-text-icon img, .icon-and-text-icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .icon-and-text-content {
    flex-grow: 1;
  }

  .icon-and-text-content h3 {
    margin: 0 0 5px;
    font-size: 1.2rem;
    font-weight: 600;
    background: linear-gradient(180deg, #f2e4ad, #f3dbc4 45%, #cfb37b 75%, #f3dbc4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    text-transform: uppercase;
  }

  .icon-and-text-content .rte,
  .icon-and-text-content .rte p,
  .icon-and-text-content .rte a {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.4;
    background: linear-gradient(180deg, #f2e4ad, #f3dbc4 45%, #cfb37b 75%, #f3dbc4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    text-decoration: none;
  }
  
  .icon-and-text-content .rte a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <div class="icon-and-text-wrapper">
      {%- if section.settings.heading != blank -%}
        <div class="icon-and-text-header">
           {%- if section.settings.icon != blank -%}
             <div class="icon-and-text-header-icon">
               {{ section.settings.icon }}
             </div>
           {%- endif -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        </div>
      {%- endif -%}

      <div class="icon-and-text-grid">
        {%- for block in section.blocks -%}
          <div class="icon-and-text-item" {{ block.shopify_attributes }}>
            {%- if block.settings.svg_icon != blank or block.settings.image != blank -%}
              <div class="icon-and-text-icon">
                {%- if block.settings.svg_icon != blank -%}
                  {{ block.settings.svg_icon }}
                {%- elsif block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 50 }}" width="24" height="24" loading="lazy">
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="icon-and-text-content">
              {%- if block.settings.heading != blank -%}
                <h3>{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

