{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* GSAP Initial State: Hidden and shifted down */
  .gsap-reveal-title,
  .gsap-reveal-item {
    opacity: 0;
    visibility: hidden;
    transform: translateY(50px);
    will-change: transform, opacity;
  }

  /* Ensure smooth transitions for any hover effects you might have */
  .noir-grid__link {
    display: block;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }
/* Mobile-specific fix for the 5th grid item */
  @media screen and (max-width: 749px) {
   /* .section-{{ section.id }}-padding .grid__item:nth-child(5) {
      grid-column: span 2;
      width: 100%;
      max-width: 100%;
    }
    .section-{{ section.id }}-padding .grid__item:nth-child(5) .noir-grid__media{
          aspect-ratio: 4 / 3;
    }*/
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width noir-grid">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }} gsap-reveal-title">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endunless -%}

    <ul class="grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down {% if section.settings.enable_mobile_slider %}noir-mobile-slider{% endif %}" role="list">
    {% comment %} <ul class="noir-mobile-slider grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down" role="list"> {% endcomment %}
      {%- for block in section.blocks -%}
        <li class="grid__item noir-grid__item gsap-reveal-item" {{ block.shopify_attributes }}>
          <a {% if block.settings.link %} href="{{ block.settings.link }}" {% else %} role="link" aria-disabled="true" {% endif %} class="noir-grid__link">
            <div class="noir-grid__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_tag: loading: 'lazy', widths: '165, 360, 495, 750, 990', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- if block.settings.content_position == 'absolute' -%}
                <div class="noir-grid__content--absolute">
                  <div class="noir-grid__info">
                    <h3 class="noir-grid__title {{ block.settings.block_heading_size }}">
                      {{ block.settings.title | escape }}
                    </h3>
                  </div>
                  {%- if section.settings.show_arrow -%}
                    <div class="noir-grid__icon">
                      <svg aria-hidden="true" width="12" viewBox="0 0 10 10"><path d="m3 9 4-4-4-4" stroke="currentColor" stroke-linecap="square" fill="none"></path></svg>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

            {%- if block.settings.content_position == 'below' -%}
              <div class="noir-grid__content--below">
                <div class="noir-grid__info">
                  <h3 class="noir-grid__title {{ block.settings.block_heading_size }}">
                    {{ block.settings.title | escape }}
                  </h3>
                  {%- if block.settings.content != blank -%}
                    <div class="noir-grid__text rte">{{ block.settings.content }}</div>
                  {%- endif -%}
                </div>
                {%- if section.settings.show_arrow -%}
                  <div class="noir-grid__icon">
                    <svg aria-hidden="true" width="12" viewBox="0 0 10 10"><path d="m3 9 4-4-4-4" stroke="currentColor" stroke-linecap="square" fill="none"></path></svg>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
@media screen and (max-width: 767px) {
  .noir-mobile-slider {
    display: flex !important;
    flex-wrap: nowrap !important;
    overflow-x: auto;
    overflow-y: hidden;
    gap: 12px;
    padding-bottom: 10px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .noir-mobile-slider::-webkit-scrollbar {
    display: none;
  }

  .noir-mobile-slider .grid__item {
    flex: 0 0 70%;
    max-width: 70%;
    scroll-snap-align: start;
  }
}
</style>  

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof gsap !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);

      const section = document.querySelector('.section-{{ section.id }}-padding');
      const title = section.querySelector('.gsap-reveal-title');
      const gridItems = section.querySelectorAll('.gsap-reveal-item');

      // The Master Animation Timeline
      const playReveal = () => {
        const tl = gsap.timeline({ overwrite: true });

        // Step 1: Slide up Title
        if (title) {
          tl.to(title, {
            y: 0,
            opacity: 1,
            visibility: 'visible',
            duration: 1.2,
            ease: "expo.out"
          });
        }

        // Step 2: Cascade Grid Items (Starting slightly before title finishes)
        tl.to(gridItems, {
          y: 0,
          opacity: 1,
          visibility: 'visible',
          duration: 1.4,
          stagger: 0.1, // Adjust for faster/slower cascading
          ease: "expo.out"
        }, "-=0.9"); // Overlap with title animation by 0.9s
      };

      const resetReveal = () => {
        gsap.set([title, gridItems], {
          y: 50,
          opacity: 0,
          visibility: 'hidden'
        });
      };

      // 1. Preloader Check
      window.addEventListener('preloaderFinished', () => {
        const rect = section.getBoundingClientRect();
        if (rect.top < window.innerHeight) {
          playReveal();
        }
      });

      // 2. Scroll Animation (Each Scroll)
      ScrollTrigger.create({
        trigger: section,
        start: "top 88%", 
        onEnter: () => {
          if(!document.body.classList.contains('loading')) {
            playReveal();
          }
        },
        onEnterBack: playReveal,
        onLeave: resetReveal,
        onLeaveBack: resetReveal
      });
    }
  });
</script>


{% schema %}
{
  "name": "Noir Grid Flexible",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "title", "default": "Shop by Ritual", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    { "type": "checkbox", "id": "show_arrow", "default": true, "label": "Show Arrow Icon" },
    { "type": "image_picker", "id": "background_image", "label": "Section Background Image" },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on Desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1",
      "label": "Columns on Mobile"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_slider",
      "label": "Enable Mobile Slider",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "grid_item",
      "name": "Grid Block",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Block Image" },
        {
          "type": "select",
          "id": "content_position",
          "options": [
            { "value": "absolute", "label": "On Image (Absolute)" },
            { "value": "below", "label": "Below Image" }
          ],
          "default": "below",
          "label": "Content Position"
        },
        { "type": "text", "id": "title", "default": "Title", "label": "Title" },
        {
          "type": "select",
          "id": "block_heading_size",
          "options": [
            { "value": "h4", "label": "Small" },
            { "value": "h3", "label": "Medium" },
            { "value": "h2", "label": "Large" }
          ],
          "default": "h3",
          "label": "Block Title Size"
        },
        { "type": "richtext", "id": "content", "label": "Description (Only for 'Below' position)" },
        { "type": "url", "id": "link", "label": "Block Link" }
      ]
    }
  ],
  "presets": [{ "name": "Noir Grid Flexible" }]
}
{% endschema %}
