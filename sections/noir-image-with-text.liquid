{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .noir-iwt {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    overflow: hidden;
  }

  .noir-iwt__item {
    width: 100%;
    display: flex;
    box-sizing: border-box;
    position: relative;
  }
  .noir-iwt__content-container {
    padding: 2.5rem 1.25rem;
    display: flex;
    flex-direction: column;
  }
  .noir-iwt__content-container  .rich-text__heading {
    font-size:26px;
    margin-bottom:10px;
        background: linear-gradient(180deg, #f2e4ad, #f3dbc4 45%, #cfb37b 75%, #f3dbc4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    font-size: calc(var(--font-heading-scale) * 4rem);
    text-transform: uppercase;
  }
    .noir-iwt__content-container   .rich-text__text p, .noir-iwt__content-container   .rich-text__text a {
        /*font-weight: 400;*/
         background: linear-gradient(180deg, #f2e4ad, #f3dbc4 45%, #cfb37b 75%, #f3dbc4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    
      }


  @media screen and (min-width: 750px) {
    .noir-iwt__item { width: 50%; }
    .noir-iwt--reverse { flex-direction: row-reverse; }
  .noir-iwt__content-container {
    padding: 5rem 3rem;
    display: flex;
    flex-direction: column;
  }

  }

  .noir-iwt__image-container img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }



  /* Vertical Alignment */
  .v-align-top { justify-content: flex-start; }
  .v-align-center { justify-content: center; }
  .v-align-bottom { justify-content: flex-end; }

  /* Horizontal Alignment */
  .h-align-left { text-align: left; align-items: flex-start; }
  .h-align-center { text-align: center; align-items: center; }
  .h-align-right { text-align: right; align-items: flex-end; }

  .rich-text__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .h-align-center .rich-text__buttons { justify-content: center; }
  .h-align-right .rich-text__buttons { justify-content: flex-end; }

  .noir-grid__icon {
    display: inline-flex;
    margin-left: 0.8rem;
    align-items: center;
  }

  .noir-grid__icon svg {
    fill: none;
    stroke: currentColor;
  }

 @media(max-width:768px){ 
.noir-iwt__item .rich-text__blocks {
    text-align: center;
}
.noir-iwt__item .rich-text__text.rte.gsap-rich-text {
    padding: 0px 40px;
    text-align: justify;
            max-width: 370px;
        margin: auto;
}
.noir-iwt__content-container  .rich-text__heading {
    font-size:30px!important;
  }
}


{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient {% unless section.settings.full_width %}page-width{% endunless %}">
  <div class="section-{{ section.id }}-padding">
    <div class="noir-iwt {% if section.settings.layout == 'image_last' %}noir-iwt--reverse{% endif %}">
      
      {%- comment -%} Image Side {%- endcomment -%}
      <div class="noir-iwt__item noir-iwt__image-container">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', sizes: '50vw', widths: '375, 550, 750, 1100, 1500' }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- comment -%} Content Side {%- endcomment -%}
      <div class="noir-iwt__item noir-iwt__content-container v-align-{{ section.settings.vertical_alignment }} h-align-{{ section.settings.content_alignment }}">
        <div class="rich-text__blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                <h2 class="rich-text__heading rte {{ block.settings.heading_size }} gsap-rich-text" {{ block.shopify_attributes }}>
                  {{ block.settings.heading }}
                </h2>
              
              {%- when 'text' -%}
                <div class="rich-text__text rte gsap-rich-text" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>

              {%- when 'button' -%}
                <div class="rich-text__buttons gsap-rich-text" {{ block.shopify_attributes }}>
                  {%- if block.settings.button_label != blank -%}
                    <a href="{{ block.settings.button_link }}" class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}">
                      {{- block.settings.button_label | escape -}}
                      {%- if section.settings.show_arrow -%}
                        <span class="noir-grid__icon"><svg width="14" height="14" viewBox="0 0 10 10"><path d="m3 9 4-4-4-4" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_2 != blank -%}
                    <a href="{{ block.settings.button_link_2 }}" class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}">
                      {{- block.settings.button_label_2 | escape -}}
                      {%- if section.settings.show_arrow -%}
                        <span class="noir-grid__icon"><svg width="14" height="14" viewBox="0 0 10 10"><path d="m3 9 4-4-4-4" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof gsap !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);

      const section = document.querySelector('.section-{{ section.id }}-padding');
      const items = section.querySelectorAll('.gsap-rich-text');

      const triggerIn = () => {
        gsap.to(items, {
          y: 0,
          opacity: 1,
          visibility: 'visible',
          duration: 1.2,
          stagger: 0.12,
          ease: "expo.out",
          overwrite: true
        });
      };

      const triggerReset = () => {
        gsap.set(items, {
          y: 50,
          opacity: 0,
          visibility: 'hidden'
        });
      };

      // Handle Preloader Logic (Wait for your 6.5s delay)
      window.addEventListener('preloaderFinished', () => {
        const rect = section.getBoundingClientRect();
        if (rect.top < window.innerHeight) {
          triggerIn();
        }
      });

      // ScrollTrigger for recurring animation (each scroll)
      ScrollTrigger.create({
        trigger: section,
        start: "top 88%",
        onEnter: () => {
          if(!document.body.classList.contains('loading')) {
            triggerIn();
          }
        },
        onEnterBack: triggerIn,
        onLeave: triggerReset,
        onLeaveBack: triggerReset
      });
    }
  });
</script>
{% schema %}
{
  "name": "Noir Image with Text",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "image_first", "label": "Image First" },
        { "value": "image_last", "label": "Image Last" }
      ],
      "default": "image_first",
      "label": "Desktop Image Placement"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Horizontal Content Alignment"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center",
      "label": "Vertical Content Alignment"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width (Edge to Edge)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show Arrow in Buttons",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Image with text",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" }
          ],
          "default": "h1",
          "label": "Heading Size"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>",
          "label": "Description"
        }
      ]
    },
    {
      "type": "button",
      "name": "Buttons",
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "First Button Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "First Button Link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "default": false,
          "label": "Use Secondary Style"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Second Button Label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Second Button Link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_2",
          "default": false,
          "label": "Use Secondary Style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Noir Image with Text",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}