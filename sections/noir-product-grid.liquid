{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- if section.settings.image_shape == 'blob' -%}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  {{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
  {{ 'price-per-item.css' | asset_url | stylesheet_tag }}
  {{ 'quick-order-list.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}



{%- style -%}
  .noir-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
    {% if section.settings.show_border_top %}border-top: 1px solid #4b443e;{% endif %}
    {% if section.settings.show_border_bottom %}border-bottom: 1px solid #4b443e;{% endif %}
    --noir-cols-desktop: {{ section.settings.columns_desktop }};
    --noir-cols-mobile: {{ section.settings.columns_mobile }};
  }

  .custom-grid p {
    margin: 0;
    background: linear-gradient(180deg, #f2e4ad, #f3dbc4 45%, #cfb37b 75%, #f3dbc4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    font-size: 16px;
    text-transform: uppercase;
    padding-bottom: 10px;
}

  @media screen and (min-width: 750px) {
    .noir-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .noir-title-wrapper-{{ section.id }} {
    text-align: center;
    margin-bottom: 1rem;
  }

  /* Swiper Mobile Styles */
  {% if section.settings.enable_mobile_slider %}
    @media screen and (max-width: 749px) {
      .noir-product-grid-{{ section.id }}.swiper-wrapper {
        display: flex;
        grid-template-columns: none;
        gap: 0;
        padding:0;
      }
      .swiper-pagination-bullet-active {
        background: currentColor;
      }
      .noir-grid-item.swiper-slide {
        height: auto;
        padding: 0 0px; /* spacing between slides */
      }
      .custom-grid p {
          font-size: 14px;
          padding-top: 10px;
          padding-bottom: 0;
      }
    }
  {% endif %}

  /* Desktop Grid Styles */
  @media screen and (min-width: 750px) {
    .noir-product-grid-{{ section.id }} {
      display: grid;
      list-style: none;
      padding: 0;
      margin: 0;
      gap: var(--grid-desktop-horizontal-spacing);
      grid-template-columns: repeat(var(--noir-cols-desktop), 1fr);
    }
    .noir-product-grid-{{ section.id }}.swiper-wrapper {
        transform: none !important; /* Disable swiper transform on desktop */
    }
  }

  /* Fallback for mobile if slider is disabled */
  @media screen and (max-width: 749px) {
    {% unless section.settings.enable_mobile_slider %}
      .noir-product-grid-{{ section.id }} {
        display: grid;
        list-style: none;
        padding: 0;
        gap: var(--grid-mobile-horizontal-spacing);
        grid-template-columns: repeat(var(--noir-cols-mobile), 1fr);
      }
    {% endunless %}
  }

  .noir-grid-item {
      height: 100%;
  }
{%- endstyle -%}

{%- liquid
  assign products_to_display = section.settings.collection.all_products_count
  if section.settings.collection.all_products_count > section.settings.products_to_show
    assign products_to_display = section.settings.products_to_show
    assign more_in_collection = true
  endif

  assign max_columns_to_show = section.settings.columns_mobile | plus: 0
  if section.settings.columns_desktop > max_columns_to_show
    assign max_columns_to_show = section.settings.columns_desktop
  endif
-%}

<div class="noir-section-{{ section.id }} color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="collection {% if section.settings.full_width %} collection--full-width{% endif %}">
    
    <div class="custom-grid noir-title-wrapper-{{ section.id }} page-width">
      {%- if section.settings.title != blank -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
        <p>{{ section.settings.para }}</p>
      {%- endif -%}
    </div>

    <div class="page-width">
      <div class="{% if section.settings.enable_mobile_slider %}swiper swiper-mobile-{{ section.id }}{% endif %}">
        <ul id="NoirGrid-{{ section.id }}"
            class="noir-product-grid-{{ section.id }} {% if section.settings.enable_mobile_slider %}swiper-wrapper{% endif %} contains-card contains-card--product">
          
          {%- if section.settings.collection.products.size > 0 -%}
            {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
              <li class="noir-grid-item {% if section.settings.enable_mobile_slider %}swiper-slide{% endif %}">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: section.settings.image_shape,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  section_id: section.id,
                  quick_add: section.settings.quick_add
                %}
              </li>
            {%- endfor -%}
          {%- else -%}
             {%- for i in (1..section.settings.columns_desktop) -%}
              <li class="noir-grid-item {% if section.settings.enable_mobile_slider %}swiper-slide{% endif %}">
                {%- assign placeholder_image = 'product-apparel-' | append: forloop.rindex -%}
                {% render 'card-product', show_vendor: section.settings.show_vendor, media_aspect_ratio: section.settings.image_ratio, placeholder_image: placeholder_image %}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>

        {% if section.settings.enable_mobile_slider and section.settings.show_pagination %}
          <div class="swiper-pagination swiper-pagination-{{ section.id }} slider-mobile-only"></div>
        {% endif %}
      </div>

      {%- if section.settings.show_view_all and more_in_collection -%}
        <div class="center" style="margin-top: 4rem;">
          <a href="{{ section.settings.collection.url }}" class="button">
            {{ 'sections.featured_collection.view_all' | t }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>



<script>
  document.addEventListener('DOMContentLoaded', function() {
    const initSwiper = () => {
      // Check if mobile and if the setting is enabled
      if (window.innerWidth < 750 && {{ section.settings.enable_mobile_slider | default: false }}) {
        new Swiper('.swiper-mobile-{{ section.id }}', {
          slidesPerView: {{ section.settings.columns_mobile | default: 1.2 }},
          spaceBetween: 10,
          grabCursor: true,
          loop: true,
          speed: 3000,  
          autoplay: {
            delay: 0,  
            disableOnInteraction: false,
            pauseOnMouseEnter: true,
          },
          // If you prefer it to slide and then stop/pause, use these instead:
          // speed: 600,
          // autoplay: { delay: 3000 },
          
          pagination: {
            el: '.swiper-pagination-{{ section.id }}',
            clickable: true,
          },
        });
      }
    };

    initSwiper();
  });
</script>

{% schema %}
{
  "name": "Noir Product Grid Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Mobile Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_slider",
      "label": "Enable Slider on Mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show Slider Dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns on Desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "1",
      "label": "Slides per view (Mobile)",
      "options": [
        { "value": "1", "label": "1 Slide" },
        { "value": "1.2", "label": "1.2 Slides (Peeking)" },
        { "value": "2", "label": "2 Slides" }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Featured Collection",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "text",
      "id": "para",
      "default": "Lorem Ispum",
      "label": "Sub Text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Product Card Settings"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to Image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "adapt",
      "label": "Image Ratio"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image Shape",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "arch", "label": "Arch" },
        { "value": "blob", "label": "Blob" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show Secondary Image on Hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show Vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show Product Rating"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "none",
      "label": "Quick Add Style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" },
        { "value": "bulk", "label": "Bulk" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Noir Product Grid Slider"
    }
  ]
}
{% endschema %}