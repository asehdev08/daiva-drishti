<style>
  body.loading {
    overflow: hidden;
  }

  /* Full screen black overlay */
  .preloader {
    position: fixed;
    inset: 0;
    background: #000;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: opacity 1.2s ease-in-out;
  }

  .preloader.fade-out {
    opacity: 0;
    pointer-events: none;
  }

  /* Image container */
  .deity-container {
    width: 180px;
    height: 180px;
    opacity: 0;
    transition: opacity 2.5s ease-in-out; /* very slow fade */
  }

  .deity-container.fade-in {
    opacity: 1;
  }

  .deity-container.fade-out {
    opacity: 0;
  }

  .deity {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
<div class="preloader" id="preloader">
  <div class="deity-container" id="ddBox">
    <img
      class="deity"
      src="https://cdn.shopify.com/s/files/1/1000/2232/1446/files/daiva_drishti_logo_highres-01.png?v=1770903416"
      alt="DD"
      loading="eager"
    />
  </div>
</div>
<script>
  // Select DOM elements
  const preloader = document.getElementById('preloader');
  const ddBox = document.getElementById('ddBox');
  const HAS_SEEN_KEY = 'hasSeenPreloader';

  // Check if user has already seen the animation
  if (localStorage.getItem(HAS_SEEN_KEY)) {
    // Skip animation: Remove preloader immediately
    preloader.remove();
    document.body.classList.remove('loading');
    window.dispatchEvent(new Event('preloaderFinished'));
  } else {
    // First time logic
    document.body.classList.add('loading');

    const img = new Image();
    img.src = ddBox.querySelector('img').src;

    img.onload = () => {
      // 1. Fade image IN
      setTimeout(() => {
        ddBox.classList.add('fade-in');
      }, 500);

      // 2. Fade image OUT
      setTimeout(() => {
        ddBox.classList.remove('fade-in');
        ddBox.classList.add('fade-out');
      }, 4000);

      // 3. Fade out background black screen
      setTimeout(() => {
        preloader.classList.add('fade-out');
      }, 5500);

      // 4. Final Cleanup
      setTimeout(() => {
        preloader.remove();
        document.body.classList.remove('loading');
        
        // Mark as seen in LocalStorage
        localStorage.setItem(HAS_SEEN_KEY, 'true');
        
        window.dispatchEvent(new Event('preloaderFinished'));
      }, 6000);
    };

    // Safety fallback
    setTimeout(() => {
      if (!img.complete && document.getElementById('preloader')) {
        preloader.remove();
        document.body.classList.remove('loading');
      }
    }, 9000);
  }
</script>