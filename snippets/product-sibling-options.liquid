{% comment %}
  Snippet: Product Sibling Options (custom.product_options)
  Displays linked products as beautiful color/variant swatches.
{% endcomment %}

{%- if product.metafields.custom.product_options.value != blank -%}
  <div class="product-siblings-wrapper" {{ block.shopify_attributes }}>
    <span class="form__label" style="display: block; margin-bottom: 1rem;">
      Available Options: <strong>{{ product.options_with_values | where: "name", "Color" | map: "values" | first }}</strong>
    </span>
    
    <div class="sibling-options-list" style="">
      {%- for sibling in product.metafields.custom.product_options.value -%}
        {%- assign is_active = false -%}
        {%- if sibling.handle == product.handle -%}
          {%- assign is_active = true -%}
        {%- endif -%}

        <a href="{{ sibling.url }}" 
           class="sibling-option-item {% if is_active %}is-active{% else %}is-faded{% endif %}"
           title="{{ sibling.title }}">
          <div class="sibling-image-wrapper">
             <img 
               src="{{ sibling.featured_media | image_url: width: 150 }}" 
               alt="{{ sibling.title }}"
               loading="lazy"
               width="60"
               height="60"
             >
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>

  <style>
    .product-siblings-wrapper{
     padding-top:3.5rem;
    }
    .sibling-options-list {
      margin-bottom: 2.5rem;
      display: flex; 
      flex-wrap: wrap; 
      gap: 12px;
    }
    .sibling-option-item {
      text-decoration: none;
      border-radius: 4px;
      padding: 2px;
      transition: all 0.3s ease;
      border: 1px solid transparent;
      display: inline-block;
      line-height: 0;
    }
    .sibling-image-wrapper {
      width: 55px;
      height: 55px;
      overflow: hidden;
      border-radius: 2px;
      background: #f5f5f5;
    }
    .sibling-image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    
    /* Faded effect for inactive products */
    .sibling-option-item.is-faded {
      opacity: 0.5;
      filter: grayscale(20%);
    }
    .sibling-option-item.is-faded:hover {
      opacity: 1;
      filter: grayscale(0%);
      border-color: #e8e8e8;
      transform: translateY(-2px);
    }

    /* Active product styling - Bold border */
    .sibling-option-item.is-active {
      opacity: 1;
      border: 1.5px solid #000; /* Change to your brand color */
      transform: scale(1.05);
      pointer-events: none;
      opacity: 1;
      filter: grayscale(0%);
      border-color: #e8e8e8;
      transform: translateY(-2px);
    }
    .sibling-option-item.is-active .sibling-image-wrapper {
        border-radius: 1px;
    }
@media screen and (max-width: 989px) {
    .sibling-image-wrapper {
      width: 45px;
      height: 45px;
    }
    .sibling-options-list {
      gap: 6px;
    }
}
  </style>
{%- endif -%}