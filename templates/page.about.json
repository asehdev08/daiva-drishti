          "settings": {
            "heading": "About Us",
            "heading_size": "h1"
          }
        },
        "text_zdpADw": {
          "type": "text",
          "settings": {
            "text": "<p>DAIVA Drishti™ was born from a simple belief — you can’t pour from an empty cup. <br/><br/>We spend so much of our lives showing up for others, <br/>that we forget to show up for ourselves. <br/><br/>At its core, DAIVA Drishti™ is built around this idea: <br/>when you take care of yourself, everything else flows better. <br/><br/>Every product we create is designed to fit into your daily life — not as a ritual you have to follow, but as a moment you get to enjoy. <br/><br/></p>"
          }
        }
      },
      "block_order": [
