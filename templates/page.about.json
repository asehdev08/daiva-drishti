    "noir_image_with_text_MLUfjd": {
      "type": "noir-image-with-text",
      "blocks": {
        "heading_PUYyY3": {
          "type": "heading",
          "settings": {
            "heading": "About the founder",
            "heading_size": "h1"
          }
        },
        "text_ywzYE9": {
          "type": "text",
          "settings": {
            "text": "<p>Trisha Om Banerjee, Founder of DAIVA Drishti™, is a marketing and fashion professional with over a decade of experience across luxury branding, retail strategy, and consumer psychology.  <br/><br/>With academic roots in commerce and sustainable fashion from the London College of Fashion, she has worked with leading brands like Superdry, Dune London, and Lakme Fashion Week across India, and gained international exposure with Stella McCartney (Kering Group) and H&M <br/>in London. <br/><br/>Her journey across global markets and diverse consumer spaces shapes DAIVA Drishti™ a brand that blends luxury, intention, and Indian wisdom into modern everyday rituals. <br/><br/></p>"
          }
        }
      },
      "block_order": [
