    "noir_image_with_text_3yAa3D": {
      "type": "noir-image-with-text",
      "blocks": {
        "heading_rgxQhH": {
          "type": "heading",
          "settings": {
            "heading": "Founder’s Note",
            "heading_size": "h1"
          }
        },
        "text_D6eaX9": {
          "type": "text",
          "settings": {
            "text": "<p>DAIVA Drishti™ comes from what has quietly worked over the last five years.     <br/><br/>Be it reading the Gita with a fragrant candle lit, ending the day in mediation and mantra chants , letting my space feel calm through scent  and beginning mornings with a simple affirmation over coffee. <br/><br/>Over time, I began to notice something shift.<br/>Not in big, dramatic ways.. but in how I felt, responded and moved through my days. <br/><br/>Things started to slow down.<br/>The anxiety softened and faith grew. <br/>Everything felt a little more steady, a little more clear. <br/><br/>And somewhere along the way, it became clear - it was never about doing more.<br/>Just about having small, meaningful moments to return to.<br/><br/>That’s what DAIVA Drishti™ is built around.<br/><br/>A way to bring these moments into everyday life — gently, without pressure, without overcomplicating it.<br/><br/>It comes from a deep respect for Indian wisdom, and years of working closely with design, products, and people.<br/><br/>Not to tell you how to live, but to offer something you can make your own. <br/><br/>Something that meets you where you are, and stays with you, in the simplest way.<br/><br/>— Founder, DAIVA Drishti™</p>"
          }
        }
      },
      "block_order": [
        "heading_rgxQhH",
        "text_D6eaX9"
      ],
