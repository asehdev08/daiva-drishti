    "noir_image_with_text_pc6n3K": {
      "type": "noir-image-with-text",
      "blocks": {
        "heading_Xc3tai": {
          "type": "heading",
          "settings": {
            "heading": "Our Philosophy",
            "heading_size": "h1"
          }
        },
        "text_9hVMYy": {
          "type": "text",
          "settings": {
            "text": "<p>Life gets loud. You don’t have to. <br/>Our philosophy is simple — create small moments that bring you back to calm, clarity, and yourself. <br/>Because how you show up for yourself shapes everything else. <br/><br/></p>"
          }
        }
      },
      "block_order": [
