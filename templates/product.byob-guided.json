        "custom_liquid_Dmk3bB": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .hide-media {\n    display: none !important; \/* Added !important to ensure layout overrides *\/\n    width: 0;\n  }\n<\/style>\n\n<script>\n  const handle = \"products\/\" + \"{{ product.handle }}\" + \".js\";\n\n  fetch(window.Shopify.routes.root + handle)\n    .then(response => response.json())\n    .then(product => {\n      \/\/ 1. Get the list of allowed option names from settings (e.g., \"Color, Material, Type\")\n      const optionsToWatch = \"{{settings.media_grouping_option}}\".split(\",\").map(item => item.trim());\n      \n      \/\/ 2. Find the FIRST option from your list that this specific product actually uses\n      const groupOption = product.options.find(option => optionsToWatch.includes(option.name)) || null;\n      \n      if (!groupOption) {\n        console.log(\"No matching grouping options found for this product.\");\n        return;\n      }\n\n      \/\/ Retrieve the applicable option values (could be Colors, Types, Materials, etc.)\n      const groupValues = groupOption.values;\n      \n      \/\/ Build an object to store the starting image positions for each variant value\n      const groupImagePositions = {};\n      \n      groupValues.forEach(value => {\n        \/\/ Find the first variant matching this value and get its featured image position\n        const variant = product.variants.find(variant => variant.options[groupOption.position - 1] === value);\n        \n        if (variant && variant.featured_media) {\n          groupImagePositions[value] = variant.featured_media.position;\n        }\n      });    \n      \n      \/\/ Sort values based on their starting positions to calculate image ranges\n      const sortedValues = Object.entries(groupImagePositions).sort((a, b) => a[1] - b[1]);\n      \n      \/\/ Calculate ranges\n      const groupImageRanges = {};\n      sortedValues.forEach((item, index) => {\n        const valueName = item[0];\n        const startPos = item[1];\n        const endPos = sortedValues[index + 1] ? sortedValues[index + 1][1] : null;\n        \n        groupImageRanges[valueName] = endPos ? [startPos, endPos] : [startPos];\n      });\n\n      \/\/ Build an object to store image IDs grouped by the variant value\n      const groupImageIDs = {};\n      Object.entries(groupImageRanges).forEach(([value, range]) => {\n        const startPos = range[0];\n        const endPos = range[1] || product.media.length + 1;\n        \n        const imageIDs = product.media\n          .filter((media, index) => {\n            const imagePosition = index + 1; \n            return imagePosition >= startPos && imagePosition < endPos;\n          })\n          .map(media => media.id);\n\n        groupImageIDs[value] = imageIDs;\n      });\n\n      const mediaGallery = document.querySelector('media-gallery');\n      const productSection = document.querySelector(\".product-variant-id\");\n      const sectionID = \"{{ section.id }}\";\n\n      \/\/ Apply data-media-group attribute to DOM elements\n      Object.entries(groupImageIDs).forEach(([value, imageIDs]) => {\n        imageIDs.forEach(mediaID => {\n          const selector = `[data-media-id=\"${sectionID}-${mediaID}\"], [data-target=\"${sectionID}-${mediaID}\"]`;\n          const mediaItems = mediaGallery.querySelectorAll(`li${selector}`);\n          mediaItems.forEach(mediaItem => {\n            mediaItem.setAttribute('data-media-group', value);\n          });\n        });\n      });\n\n      \/\/ Function to show\/hide based on current selection\n      const showVariantImage = () => {\n        const variantSelects = document.querySelector('variant-selects');\n        if (!variantSelects) return;\n\n        \/\/ Get all selected option values on the page right now\n        let currentValues = Array.from(\n          variantSelects.querySelectorAll('select option[selected], select, fieldset input:checked')\n        ).map(el => el.value);\n        \n        \/\/ Find which selected value matches our dynamic ranges\n        let selectedValue = currentValues.find(value => groupImageRanges.hasOwnProperty(value));\n      \n        \/\/ Fallback for native select elements if .value array extraction varies\n        if (!selectedValue) {\n          variantSelects.querySelectorAll('select').forEach(select => {\n            if(groupImageRanges.hasOwnProperty(select.value)) {\n              selectedValue = select.value;\n            }\n          });\n        }\n\n        \/\/ Show\/Hide images based on selected value\n        mediaGallery.querySelectorAll('ul li[data-media-group]').forEach((mediaItem) => {\n          if (mediaItem.getAttribute('data-media-group') === selectedValue) {\n            mediaItem.classList.remove('hide-media');\n          } else {\n            mediaItem.classList.add('hide-media');\n          }\n        });\n      \n        \/\/ Reinitialize the slider if Dawn theme component exists\n        mediaGallery.querySelectorAll('slider-component').forEach(slider => {\n          if (typeof slider.initPages === 'function') slider.initPages();\n        });\n      }\n\n      showVariantImage();\n      \n      if (productSection) {\n        productSection.addEventListener('change', showVariantImage); \n      }\n    })\n    .catch(error => console.error(\"Error fetching product data:\", error));\n<\/script>"
          }
        },
